<!doctype html>
<html lang="en">
<head>
    <meta name="google-site-verification" content="cqK-KCI2JTi9WYqrS3Hz94WAav1UH8HVIQlx7MuyTvs" />
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="TEDDY Daddy Pre School — Learn, Play, Grow.">
<title>TEDDY Daddy Pre School</title>
<style>
:root{--ink:#172554;--orange:#ff7a59;--blue:#2196f3;--green:#43c95e;--yellow:#ffc107;--pink:#e83e8c;--bg:#fffaf4;--white:#fff;--muted:#64748b;--line:#e8edf4;--shadow:0 24px 70px rgba(23,37,84,.12)}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:Inter,Arial,sans-serif;color:var(--ink);background:#fff;line-height:1.6}a{text-decoration:none;color:inherit}.wrap{width:min(1180px,92%);margin:auto}
.top{background:var(--ink);color:white;font-size:13px;padding:9px 0}.top .wrap{display:flex;justify-content:space-between;gap:15px}
nav{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.92);backdrop-filter:blur(15px);border-bottom:1px solid var(--line)}.nav{height:82px;display:flex;align-items:center;justify-content:space-between}.brand img{width:205px;height:auto;display:block}.links{display:flex;gap:25px;align-items:center;font-size:14px;font-weight:800}.links a:hover{color:var(--orange)}.admit{background:var(--orange);color:#fff;padding:12px 19px;border-radius:999px}.hamb{display:none;border:0;background:none;font-size:28px;color:var(--ink)}
.hero{background:radial-gradient(circle at 10% 10%,#ffe4b8,transparent 28%),radial-gradient(circle at 90% 20%,#d8efff,transparent 30%),linear-gradient(135deg,#fffaf4,#f2f9ff);padding:78px 0;overflow:hidden}.heroGrid{display:grid;grid-template-columns:1.02fr .98fr;gap:55px;align-items:center}.pill{display:inline-block;background:white;border:1px solid #ffe0d3;color:var(--orange);font-weight:900;padding:8px 14px;border-radius:999px;font-size:12px;letter-spacing:1px}.hero h1{font-size:clamp(45px,6vw,76px);line-height:1;letter-spacing:-4px;margin:20px 0}.grad{background:linear-gradient(90deg,var(--orange),var(--pink),var(--blue));color:transparent;background-clip:text}.hero p{color:var(--muted);font-size:18px;max-width:610px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0}.btn{padding:14px 21px;border-radius:14px;font-weight:900;display:inline-block;border:2px solid transparent}.primary{background:var(--orange);color:#fff;box-shadow:0 14px 30px #ff7a5933}.secondary{border-color:var(--line);background:white}.heroVisual{background:#fff;border:12px solid #fff;border-radius:38px;box-shadow:var(--shadow);padding:15px}.heroVisual img{width:100%;height:auto;display:block;border-radius:25px}
section{padding:88px 0}.head{text-align:center;max-width:720px;margin:0 auto 42px}.eyebrow{color:var(--orange);font-weight:900;font-size:12px;letter-spacing:2px;text-transform:uppercase}.head h2{font-size:clamp(32px,4vw,50px);line-height:1.05;letter-spacing:-2px;margin:10px 0}.head p{color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{border:1px solid var(--line);border-radius:25px;padding:28px;background:#fff;box-shadow:0 10px 35px #1725540a}.card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.ico{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;font-size:28px;margin-bottom:16px}.card h3{font-size:20px;margin-bottom:7px}.card p{color:var(--muted);font-size:14px}
.about{background:var(--bg)}.aboutGrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:center}.aboutArt{background:linear-gradient(145deg,#ffd078,#ff9b81);border-radius:35px;min-height:430px;display:grid;place-items:center;font-size:125px;box-shadow:var(--shadow)}.checks{display:grid;gap:13px;margin:23px 0}.check{display:flex;gap:10px;font-weight:700}.check b{background:var(--green);color:#fff;border-radius:50%;width:24px;height:24px;display:grid;place-items:center;flex:none}
.programs{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.program{min-height:190px;padding:24px;border-radius:25px;color:#fff;display:flex;flex-direction:column;justify-content:space-between}.p1{background:linear-gradient(145deg,#ff7658,#ffb46f)}.p2{background:linear-gradient(145deg,#1689ed,#72bfff)}.p3{background:linear-gradient(145deg,#25bb76,#77dcaa)}.p4{background:linear-gradient(145deg,#7057ca,#ad92f2)}.program small{opacity:.8;font-weight:800}.program h3{font-size:24px}
.books{background:#f7f9fc}.bookGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.book{background:#fff;border-radius:25px;overflow:hidden;border:1px solid var(--line);box-shadow:0 10px 35px #1725540a}.cover{height:250px;display:grid;place-items:center;font-size:88px}.c1{background:#ffe0c8}.c2{background:#dff0ff}.c3{background:#e0f8ea}.bookInfo{padding:22px}.bookInfo p{color:var(--muted);font-size:14px;margin:6px 0 15px}
.banner{padding:0 0 88px}.bannerBox{border-radius:34px;padding:52px;background:linear-gradient(135deg,#ff7a59,#8067d8);color:#fff;display:flex;justify-content:space-between;align-items:center;gap:25px}.bannerBox h2{font-size:42px;line-height:1.05}.bannerBox p{opacity:.9;max-width:650px;margin-top:10px}.bannerBox .btn{background:#fff;color:var(--ink)}
.gallery{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:220px 220px;gap:15px}.g{border-radius:25px;display:grid;place-items:center;font-size:65px}.g:nth-child(1){grid-row:span 2;background:linear-gradient(135deg,#c8ebff,#d6f8e4)}.g:nth-child(2){background:#ffe0b5}.g:nth-child(3){background:#e9ddff}.g:nth-child(4){background:#fff0ba}.g:nth-child(5){background:#cdebdc}
.contact{background:#f7f9fc}.contactGrid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.contactCard{background:#fff;border:1px solid var(--line);border-radius:26px;padding:30px}.info{display:grid;gap:20px;margin-top:20px}.item{display:flex;gap:13px}.item .ico{margin:0;width:50px;height:50px}.item small{color:var(--muted);display:block}.form{display:grid;gap:12px}.form input,.form select,.form textarea{width:100%;font:inherit;padding:14px;border:1px solid #dbe2ea;border-radius:12px;outline:none}.form textarea{min-height:125px;resize:vertical}.form input:focus,.form select:focus,.form textarea:focus{border-color:var(--orange)}
footer{background:#111a2c;color:#b7c2d4;padding:55px 0 20px}.foot{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:40px}.foot img{width:205px;filter:brightness(0) invert(1)}.foot h3{color:#fff;margin-bottom:12px}.foot a{display:block;margin:7px 0;font-size:14px}.copy{border-top:1px solid #2e394d;margin-top:30px;padding-top:18px;text-align:center;font-size:12px}
.whatsapp{position:fixed;right:20px;bottom:20px;width:58px;height:58px;background:#20c76a;color:#fff;border-radius:50%;display:grid;place-items:center;font-size:27px;z-index:30;box-shadow:0 15px 35px #20c76a55}
@media(max-width:900px){.links{display:none;position:absolute;top:82px;left:0;right:0;background:#fff;padding:20px;flex-direction:column}.links.open{display:flex}.hamb{display:block}.heroGrid,.aboutGrid,.contactGrid{grid-template-columns:1fr}.cards{grid-template-columns:1fr 1fr}.programs{grid-template-columns:1fr 1fr}.bookGrid{grid-template-columns:1fr 1fr}.foot{grid-template-columns:1fr 1fr}.heroVisual{max-width:650px;margin:auto}}
@media(max-width:600px){.top .wrap{justify-content:center;text-align:center}.hero{padding:58px 0}.hero h1{letter-spacing:-2px}.cards,.programs,.bookGrid,.foot{grid-template-columns:1fr}.gallery{grid-template-columns:1fr 1fr;grid-template-rows:170px 170px 170px}.gallery .g:nth-child(1){grid-column:span 2;grid-row:auto}.bannerBox{display:block;padding:35px 25px}.bannerBox h2{font-size:34px}.bannerBox .btn{margin-top:20px}}

.bookActions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.bookActions .btn{font-size:.88rem;padding:11px 14px}
</style>

<style>
.cover img{width:100%;height:100%;object-fit:cover;display:block}
</style>
</head>
<body>
<div class="top"><div class="wrap"><span>🌟 Admissions Open • Nursery • LKG • UKG</span><span>📞 +91 97926 51008</span></div></div>
<nav><div class="wrap nav">
<a class="brand" href="#home"><img src="logo.svg" alt="TEDDY Daddy Pre School"></a>
<button class="hamb" onclick="document.querySelector('.links').classList.toggle('open')">☰</button>
<div class="links"><a href="#about">About</a><a href="#programs">Programs</a><a href="#books">Books</a><a href="#gallery">Gallery</a><a href="#contact">Contact</a><a class="admit" href="#admission">Admissions</a></div>
</div></nav>

<header class="hero" id="home"><div class="wrap heroGrid">
<div><span class="pill">✨ WHERE LITTLE MINDS SHINE</span><h1>Learn.<br><span class="grad">Play.</span><br>Grow.</h1><p>A joyful, safe and creative preschool where children explore, express and build strong foundations through meaningful play.</p><div class="actions"><a class="btn primary" href="#admission">🎒 Admission Enquiry</a><a class="btn secondary" href="#programs">Explore Programs →</a></div><small>✓ Activity-based learning &nbsp; ✓ Caring educators &nbsp; ✓ Creative activities</small></div>
<div class="heroVisual"><img src="logo.svg" alt="TEDDY Daddy logo"></div>
</div></header>

<section><div class="wrap"><div class="head"><div class="eyebrow">Why TEDDY Daddy</div><h2>A happy beginning for a bright future.</h2><p>Early learning designed around curiosity, creativity, confidence and joyful discovery.</p></div>
<div class="cards"><div class="card"><div class="ico" style="background:#fff0ea">🎨</div><h3>Creative Learning</h3><p>Art, stories, music and hands-on activities encourage children to learn through curiosity.</p></div><div class="card"><div class="ico" style="background:#eaf4ff">🧠</div><h3>Smart Foundations</h3><p>Age-appropriate activities build early language, numbers, observation and problem-solving.</p></div><div class="card"><div class="ico" style="background:#e8faf0">❤️</div><h3>Caring Environment</h3><p>A warm atmosphere where every little learner feels safe, valued and encouraged.</p></div></div></div></section>

<section class="about" id="about"><div class="wrap aboutGrid"><div class="aboutArt">🧸📚🎨</div><div><div class="eyebrow">About Us</div><h2>More than a school. A place to discover.</h2><p style="color:var(--muted)">TEDDY Daddy Pre School brings together playful learning, creative activities and strong early foundations in a child-friendly environment.</p><div class="checks"><div class="check"><b>✓</b> Activity-based and joyful learning</div><div class="check"><b>✓</b> Communication and confidence</div><div class="check"><b>✓</b> Creative worksheets and school books</div><div class="check"><b>✓</b> Parent-friendly learning updates</div></div><a class="btn primary" href="#contact">Talk to Our School →</a></div></div></section>

<section id="programs"><div class="wrap"><div class="head"><div class="eyebrow">Our Programs</div><h2>Made for every stage of early learning.</h2><p>Choose the program that fits your child's learning journey.</p></div><div class="programs"><div class="program p1"><small>2–3 YEARS</small><h3>Nursery</h3><span>Play • Explore • Express</span></div><div class="program p2"><small>3–4 YEARS</small><h3>LKG</h3><span>Learn • Create • Discover</span></div><div class="program p3"><small>4–5 YEARS</small><h3>UKG</h3><span>Build • Practice • Grow</span></div><div class="program p4"><small>SPECIAL</small><h3>Activities</h3><span>Art • Music • Fun</span></div></div></div></section>

<section class="books" id="books"><div class="wrap"><div class="head"><div class="eyebrow">School Books</div><h2>Learning children love to open.</h2><p>Open our digital school books with a real page-turning flipbook reader.</p></div><div class="bookGrid">

<div class="book"><div class="cover"><img src="books/class1-hindi/page-001.jpg" alt="Class 1 Hindi Book cover"></div><div class="bookInfo"><h3>Class 1 Hindi Book</h3><p>51-page Hindi learning and activity book.</p><a class="btn secondary" href="reader.html?book=class1-hindi" target="_blank" rel="noopener">📖 Open Flipbook →</a> <a class="btn secondary" href="pdfs/class1-hindi.pdf" target="_blank" rel="noopener">📄 View PDF →</a></div></div>

<div class="book"><div class="cover"><img src="books/lkg-english/page-001.jpg" alt="LKG English Book cover"></div><div class="bookInfo"><h3>LKG English Book</h3><p>45-page LKG English pre-writing and language activities.</p><a class="btn secondary" href="reader.html?book=lkg-english" target="_blank" rel="noopener">📖 Open Flipbook →</a> <a class="btn secondary" href="pdfs/lkg-english.pdf" target="_blank" rel="noopener">📄 View PDF →</a></div></div>
<div class="book"><div class="cover"><img src="books/colour-book/page-001.jpg" alt="Colour Book cover"></div><div class="bookInfo"><h3>Colour Book</h3><p>17-page colouring and colour-learning activities.</p><a class="btn secondary" href="reader.html?book=colour-book" target="_blank" rel="noopener">📖 Open Flipbook →</a> <a class="btn secondary" href="pdfs/colour-book.pdf" target="_blank" rel="noopener">📄 View PDF →</a></div></div>
<div class="book"><div class="cover"><img src="books/lkg-mathematics/page-001.jpg" alt="LKG Mathematics Book cover"></div><div class="bookInfo"><h3>LKG Mathematics Book</h3><p>47-page counting, numbers, matching and practice activities.</p><a class="btn secondary" href="reader.html?book=lkg-mathematics" target="_blank" rel="noopener">📖 Open Flipbook →</a> <a class="btn secondary" href="pdfs/lkg-mathematics.pdf" target="_blank" rel="noopener">📄 View PDF →</a></div></div>
<div class="book"><div class="cover"><img src="books/lkg-activity/page-001.jpg" alt="LKG Activity Rhymes Book cover"></div><div class="bookInfo"><h3>LKG Activity / Rhymes Book</h3><p>31-page rhymes, colours, shapes, numbers and activity collection.</p><a class="btn secondary" href="reader.html?book=lkg-activity" target="_blank" rel="noopener">📖 Open Flipbook →</a> <a class="btn secondary" href="pdfs/lkg-activity.pdf" target="_blank" rel="noopener">📄 View PDF →</a></div></div>

</div></div></section>

<section><div class="wrap"><div class="head"><div class="eyebrow">Our World</div><h2>Little moments. Big memories.</h2><p>Replace these demo blocks with real school photographs.</p></div><div class="gallery"><div class="g">🧒🎨</div><div class="g">📚</div><div class="g">🎵</div><div class="g">🧩</div><div class="g">🌱</div></div></div></section>

<div class="banner" id="admission"><div class="wrap"><div class="bannerBox"><div><div class="eyebrow" style="color:#ffe7df">Admissions</div><h2>Give your little one a joyful start.</h2><p>Submit an enquiry and our school team can contact you about the upcoming session.</p></div><a class="btn" href="#contact">Start Enquiry →</a></div></div></div>

<section class="contact" id="contact"><div class="wrap"><div class="head"><div class="eyebrow">Contact Us</div><h2>Let's meet your little learner.</h2><p>Replace the demo contact details with your actual school information.</p></div><div class="contactGrid"><div class="contactCard"><h3>School Information</h3><div class="info"><div class="item"><div class="ico" style="background:#fff0ea">📍</div><div><b>Address</b><small>Village Mati, Post Moradabad, Deva Road, Barabanki, Uttar Pradesh, India</small></div></div><div class="item"><div class="ico" style="background:#e8faf0">📞</div><div><b>Phone</b><small><a href="tel:+919792651008">+91 97926 51008</a><br><a href="tel:+919214327466">+91 92143 27466</a></small></div></div><div class="item"><div class="ico" style="background:#eaf4ff">✉️</div><div><b>Email</b><small>Add your school email</small></div></div></div></div><div class="contactCard"><h3>Admission Enquiry</h3><form class="form" onsubmit="wa(event)"><input id="name" required placeholder="Parent's Name"><input id="child" required placeholder="Child's Name"><select id="cls"><option>Nursery</option><option>LKG</option><option>UKG</option><option>Activity Program</option></select><input id="phone" required type="tel" placeholder="Mobile Number"><textarea id="msg" placeholder="Message"></textarea><button class="btn primary" type="submit">Send on WhatsApp →</button></form></div></div></div></section>

<footer><div class="wrap"><div class="foot"><div><img src="logo.svg" alt="TEDDY Daddy"><p style="margin-top:12px">Learn • Play • Grow. A joyful beginning for every little learner.</p></div><div><h3>Quick Links</h3><a href="#about">About</a><a href="#programs">Programs</a><a href="#books">Books</a><a href="#contact">Contact</a></div><div><h3>Connect</h3><a href="#contact">Admission Enquiry</a><a href="#gallery">Gallery</a><a href="#contact">WhatsApp</a></div></div><div class="copy">© <span id="year"></span> TEDDY Daddy Pre School. All rights reserved.</div></div></footer>

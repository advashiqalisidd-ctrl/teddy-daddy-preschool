<script>
document.getElementById('year').textContent=new Date().getFullYear();
function soon(e){e.preventDefault();alert('This book will be added soon.')}
function wa(e){e.preventDefault();const n=document.getElementById('name').value,c=document.getElementById('child').value,k=document.getElementById('cls').value,p=document.getElementById('phone').value,m=document.getElementById('msg').value;const num='919792651008';const t=`Hello TEDDY Daddy Pre School,%0A%0AAdmission Enquiry%0AParent: ${encodeURIComponent(n)}%0AChild: ${encodeURIComponent(c)}%0AClass: ${encodeURIComponent(k)}%0AMobile: ${encodeURIComponent(p)}%0AMessage: ${encodeURIComponent(m||'I would like to know about admission.')}`;window.open('https://wa.me/'+num+'?text='+t,'_blank')}
</script>
</body></html>